#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.nvm/versions/node/$(ls $HOME/.nvm/versions/node 2>/dev/null | tail -n 1)/bin:$HOME/.local/bin"

if [ -x "../scripts/run_precommit_all.sh" ]; then
    ../scripts/run_precommit_all.sh
else
    npm run check-build
fi
