# ==============================================================================
# iGaming Next.js Frontend — Environment Variables Template
# ==============================================================================

# Database Connection (PostgreSQL)
# Used for server-side direct queries & API fallback
DATABASE_URL=postgresql://localhost:5432/luckystart

# App & Backend URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Configuration (Optional)
# If provided with valid URLs and keys, Supabase client connects to cloud.
# If left empty, the application automatically uses PostgreSQL directly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Model Context Protocol (MCP) Configuration (Optional)
# Localhost: Leave empty to query DATABASE_URL directly, or set to http://localhost:3002 if running separate express server.
# Dev/Prod: Leave empty for direct cloud database connection, or set to dedicated MCP microservice URL.
MCP_SERVER_URL=
MCP_PORT=3002

