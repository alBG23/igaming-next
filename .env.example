# ==============================================================================
# iGaming Next.js Frontend — Environment Variables Template
# ==============================================================================

# Database Target Feature Flag: 'local', 'dev', or 'prod'
DATABASE_TARGET=dev

# Direct Database URLs (safe placeholders)
LOCAL_DATABASE_URL=postgresql://localhost:5432/luckystart
DEV_DATABASE_URL=postgres://user:password@dpg-dev-id.frankfurt-postgres.render.com/igaming_dev?sslmode=require
PROD_DATABASE_URL=postgres://user:password@prod-host:5432/igaming_prod?sslmode=require

# Database Connection (Active connection string - auto-resolves if left empty)
DATABASE_URL=

# App & Backend URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Configuration (Optional)
# If provided with valid URLs and keys, Supabase client connects to cloud.
# If left empty, the application automatically uses PostgreSQL directly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Model Context Protocol (MCP) Configuration (Optional)
# Localhost: Leave empty to query DATABASE_URL directly, or set to http://localhost:3002 if running separate express server.
# Dev/Prod: Leave empty for direct cloud database connection, or set to dedicated MCP microservice URL.
MCP_SERVER_URL=
MCP_PORT=3002

