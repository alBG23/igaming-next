# ==============================================================================
# iGaming Next.js Frontend — Environment Variables Template
# ==============================================================================

# Database Connection (PostgreSQL)
# Used for server-side direct queries & API fallback
DATABASE_URL=postgresql://localhost:5432/luckystart

# App & Backend URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Configuration (Optional)
# If provided with valid URLs and keys, Supabase client connects to cloud.
# If left empty, the application automatically uses PostgreSQL directly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Feature Flag: Active Data Source Layer ('postgres' | 'supabase')
# 'postgres': Internal PostgreSQL (Local / Dev database or Render cloud)
# 'supabase': Upstream Cloud Replica (users_view, payments_view, bets)
# Defaults to 'postgres' if omitted. Can also be switched at runtime via the UI.
NEXT_PUBLIC_DATA_SOURCE=postgres

